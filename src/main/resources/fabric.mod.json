{
    "schemaVersion": 1,
    "id": "inspecio-reborn",
    "version": "${version}",
    "name": "Inspecio Reborn",
    "description": "More and better tooltips on items!",
    "authors": [
        "NebelNidas",
        "Emi",
        "LambdAurora"
    ],
    "contributors": [],
    "contact": {
        "sources": "https://github.com/xpncvr/inspecio-reborn",
        "issues": "https://github.com/xpncvr/inspecio-reborn/issues"
    },
    "license": "LGPL-3.0-or-later",
    "icon": "assets/advancedtooltips/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.github.reviversmc.advancedtooltips.AdvancedTooltips"
        ]
    },
    "mixins": [
        "advancedtooltips.mixins.json"
    ],
    "provides": [
        "inspecio",
        "advanced-tooltips",
        "advanced-tooltips-core"
    ],
    "depends": {
        "minecraft": ">=1.21.11",
        "fabricloader": ">=0.16.0",
        "fabric-command-api-v2": "*",
        "fabric-rendering-v1": "*",
        "fabric-resource-loader-v0": "*"
    }
